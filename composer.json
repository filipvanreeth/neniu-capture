{
    "name": "neniu/verify",
    "description": "Foto- en locatieverificatie met SQLite-opslag.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "Neniu\\Verify\\": "src/"
        }
    },
    "scripts": {
        "lint": [
            "@php -l index.php",
            "@php -l i18n.php",
            "@php -l translations/en.php",
            "find src tests -name \"*.php\" -exec php -l {} \\;"
        ],
        "test": "@php tests/verification.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    }
}
