{
    "name": "neniu/capture",
    "description": "Foto- en locatieverificatie met SQLite-opslag.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "geocoder-php/nominatim-provider": "^5.8",
        "guzzlehttp/guzzle": "^8.3",
        "nikic/fast-route": "^1.3",
        "twig/twig": "^3.30",
        "vlucas/phpdotenv": "^5.8"
    },
    "autoload": {
        "psr-4": {
            "Neniu\\Capture\\": "src/"
        }
    },
    "scripts": {
        "lint": [
            "@php -l public/index.php",
            "@php -l translations/en.php",
            "find src tests -name \"*.php\" -exec php -l {} \\;",
            "@php -l dev-router.php"
        ],
        "test": [
            "@php tests/verification.php",
            "@php tests/routing.php",
            "@php tests/templates.php",
            "@php tests/assets.php",
            "@php tests/translation.php",
            "@php tests/production.php"
        ],
        "cs": "phpcs",
        "cs:fix": "phpcbf"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^4.0"
    }
}
