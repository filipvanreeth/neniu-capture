{% extends 'base.html.twig' %}

{% block content %}
    {% if not record %}
        <p class="my-4">{{ t('not_found') }}</p>
    {% else %}
        <h2 class="my-[0.83em] text-2xl font-bold">{{ t('verification_result') }}</h2>
        <p class="my-4">{{ t('integrity') }}:
            <strong>{{ t(hashValid ? 'valid' : 'invalid') }}</strong>
        </p>
        {% if hashValid %}
            <img class="my-3 w-full rounded-lg" alt="{{ t('photo_alt') }}" src="data:image/jpeg;base64,{{ record.image.base64 }}">
        {% endif %}
        <p class="my-4">{{ t('code') }}: {{ record.code }}</p>
        <p class="my-4">{{ t('timestamp') }}: {{ record.created_at }}</p>
        <p class="my-4">{{ t('gps') }}: {{ record.location.latitude }}, {{ record.location.longitude }}</p>
        <p class="my-4">{{ t('accuracy') }}: {{ record.location.accuracy_meters }} {{ t('meters') }}</p>
        <p class="my-4"><small>{{ t('gps_notice') }}</small></p>
    {% endif %}
    <a class="text-[#0000ee] underline" href="{{ captureUrl }}">{{ t('new_capture') }}</a>
{% endblock %}
