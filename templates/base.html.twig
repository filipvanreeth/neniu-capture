<!DOCTYPE html>
<html lang="{{ locale }}">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ t('page_title') }}</title>
    {% if assets.devClient %}
        <script type="module" src="{{ assets.devClient }}"></script>
    {% endif %}
    <link rel="stylesheet" href="{{ assets.stylesheet }}">
</head>

<body class="m-0 bg-zinc-100 p-6 font-sans text-base leading-[normal] text-black max-[480px]:p-3">
    <main class="box-content mx-auto max-w-[540px] rounded-[14px] bg-white p-6 max-[480px]:p-5">
        <h1 class="my-[0.67em] text-[2em] font-bold">{{ t('app_name') }}</h1>
        <p class="my-4">{{ t('intro') }}</p>

        {% block content %}{% endblock %}
    </main>
    {% block scripts %}{% endblock %}
</body>
</html>
