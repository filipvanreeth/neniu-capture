# Production-safe defaults. Copy to .env in the project root, outside public/.
APP_ENV=production

# Optional public origin for shared links (no path). Empty uses the browser URL.
APP_URL=

# Relative to project root, or absolute. Always choose a location outside public/.
STORAGE_PATH=storage

# Exact IP addresses of trusted reverse proxies, comma separated. Empty = none.
TRUSTED_PROXIES=

# Development only. Keep empty on production.
VITE_DEV_SERVER=
# Browser-visible development origins, never secrets.
VITE_BACKEND_ORIGIN=
VITE_DEV_ORIGIN=

# Public map tile provider; retain attribution and comply with its usage policy.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
